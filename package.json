{
  "name": "pm-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "typegen": "next typegen",
    "check:routes": "tsc -p tsconfig.json --noEmit",
    "gate": "npm run typecheck && npm run test",
    "seed:dev": "node scripts/seed-dev-user.mjs",
    "seed:lesson": "node scripts/seed-dev-lesson.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "fastmcp": "^3.19.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76",
    "@google/genai": "latest",
    "@supabase/ssr": "latest",
    "canvas-confetti": "latest",
    "hls.js": "latest",
    "inngest": "latest",
    "lucide-react": "latest",
    "stripe": "latest",
    "web-push": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "@types/node": "^22.18.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
